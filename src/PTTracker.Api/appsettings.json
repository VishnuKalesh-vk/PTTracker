{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/pttracker-.log",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=PTTracker;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "Secret": "super-secret-key-that-is-at-least-32-chars-long!!",
    "Issuer": "PTTracker",
    "Audience": "PTTracker",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "FileStorage": {
    "BasePath": "storage"
  },
  "EmailIngestion": {
    "SubjectFallbackWindowDays": 30,
    "MaxFileSizeBytes": 36700160,
    "AllowedAttachmentExtensions": [ ".xlsx", ".csv" ]
  }
}
